{
  "name": "amazon-clone",
  "version": "1.0.0",
  "description": "Amazon Clone - Full Stack Application",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && echo 'Frontend built successfully'",
    "start": "npm run start --workspace=backend",
    "seed": "npm run seed --workspace=backend"
  }
}
