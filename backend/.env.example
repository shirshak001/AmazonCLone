# Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (local for development)
MONGODB_URI=mongodb://localhost:27017/amazonclone

# For production on Render, use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/amazonclone

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-in-production
